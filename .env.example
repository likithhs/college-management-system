# ==============================================================================
# SESHADRIPURAM EDUCATIONAL TRUST - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment & Flask Secret Key
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key

# Database Connection (SQLite or PostgreSQL / MySQL)
# SQLite default: sqlite:///college.db
# PostgreSQL example: postgresql://college_user:secure_password@localhost:5432/college_db
DATABASE_URL=sqlite:///college.db

# Cookie & Session Security Flags (Enable for HTTPS)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# Media Upload Directory Path
UPLOAD_FOLDER=static/uploads

# SMTP Email Dispatch Server Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=admissions@spmcollege.ac.in
MAIL_PASSWORD=your-secure-app-password
MAIL_DEFAULT_SENDER=admissions@spmcollege.ac.in

# Security & Rate Limiting Thresholds
RATE_LIMIT_LOGIN=5
RATE_LIMIT_APPLY=5
RATE_LIMIT_STUDENTS_CORNER=10
RATE_LIMIT_FORUM=10
RATE_LIMIT_PDF_DOWNLOAD=20
